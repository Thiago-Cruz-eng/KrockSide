{
  "compilerOptions": {
    // O CRA gerava target es5 e moduleResolution node. O Vite emite ES moderno e
    // resolve como bundler, então os dois subiram junto com a migração.
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    // vite/client dá os tipos de import.meta.env; vitest/globals dá describe/it/expect
    // sem precisar importar em cada arquivo de teste.
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "tests-e2e"]
}
